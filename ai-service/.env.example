# Copy this file to .env for local overrides. Real OS environment variables
# always take precedence over values in .env.

# Engine: "transformers" (LoRA) by default, or "llama_cpp" (GGUF).
# To switch to the GGUF engine, change MODEL_ENGINE below to llama_cpp.
MODEL_ENGINE=transformers
PROMPT_VERSION=v4

# transformers engine (LoRA v4)
BASE_MODEL_NAME=unsloth/Qwen3-1.7B
LORA_PATH=./checkpoint-v4

# GGUF engine (only used when MODEL_ENGINE=llama_cpp)
GGUF_MODEL_PATH=./merged_model/model-v4-q4_k_m.gguf
