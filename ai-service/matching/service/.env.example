# Ket noi PostgreSQL (docker-compose.yml map cong 5433)
CVMATCH_DB_URL=postgresql://cvmatch:cvmatch@127.0.0.1:5433/cvmatch
# Khoa bi mat HMAC cho candidate_key (A2). Doi gia tri that, khong commit.
CVMATCH_HMAC_KEY=change-me
# cuda | cpu
CVMATCH_DEVICE=cuda
# 1 = dung FakeEncoder (test khong GPU)
CVMATCH_FAKE_ENCODER=0
# Thu muc config (mac dinh: services/cvmatch-ai/config)
# CVMATCH_CONFIG_DIR=

# ---- Chay nhu service (I01: `cvmatch api prod`, Dockerfile) ----
# dev | prod. prod: bat buoc CVMATCH_SERVICE_TOKEN va CVMATCH_HMAC_KEY that.
# CVMATCH_ENV=dev
# Backend Java gui header X-Service-Token; de trong = khong kiem (chi dev). /health luon mo.
# CVMATCH_SERVICE_TOKEN=
# Thu muc chua cac snapshot KB (ai-service/matching/kb-builder/out/snapshot); ban chua nap thi nap luc khoi dong.
# CVMATCH_KB_DIR=../kb-builder/out/snapshot
# Ghi de ontology_version cua config/active.yaml (nam trong bo khoa phien ban).
# CVMATCH_ONTOLOGY_VERSION=kb-2026-11-21-4
# CVMATCH_HOST=0.0.0.0
# CVMATCH_PORT=8000
# So giay cho Postgres len truoc khi bao loi.
# CVMATCH_DB_WAIT_S=120

# S05: tinh san token BERTScore khi nap (1/0) va lam nong luc khoi dong (giay, 0 = tat)
# CVMATCH_PRECOMPUTE_TOKENS=1
# CVMATCH_WARM_MAX_S=600
