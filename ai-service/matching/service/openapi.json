{
  "openapi": "3.1.0",
  "info": {
    "title": "cvmatch",
    "description": "Match CV ↔ JD (Tầng 0–3). Luồng: POST /cv, POST /jd → POST /match/jd/{jd_id} → GET /match/{run_id}/cv/{cv_id}/explain.",
    "version": "0.1.0"
  },
  "paths": {
    "/cv": {
      "post": {
        "tags": [
          "cv"
        ],
        "summary": "Post Cv",
        "description": "Luong A cho MOT CV (dong bo). `duplicate` -> tra cv_id da co.",
        "operationId": "post_cv_cv_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Cv",
                "description": "CV JSON (dau ra Module 1)"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvIngestResult"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvIngestResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvIngestResult"
                }
              }
            }
          }
        }
      }
    },
    "/cv/batch": {
      "post": {
        "tags": [
          "cv"
        ],
        "summary": "Post Cv Batch",
        "description": "Nap CV theo lo. `background=true` (mac dinh) -> 202 + job; ket qua o `GET /jobs/{id}`.",
