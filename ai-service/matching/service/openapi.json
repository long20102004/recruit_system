  "components": {
    "schemas": {
      "CvBatchIn": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items",
            "description": "cac CV JSON (dau ra Module 1)"
          },
          "background": {
            "type": "boolean",
            "title": "Background",
            "description": "true -> tra job_id, xem GET /jobs/{id}",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CvBatchIn"
      },
      "CvBatchOut": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/CvIngestResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "CvBatchOut"
      },
      "CvDeleteOut": {
        "properties": {
          "cv_id": {
            "type": "string",
            "title": "Cv Id"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "cv_id",
          "deleted"
        ],
        "title": "CvDeleteOut"
      },
      "CvIngestResult": {
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "duplicate",
              "invalid",
              "failed"
            ],
            "title": "Status"
          },
          "cv_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cv Id",
            "description": "ok: cv_id moi; duplicate: cv_id da co"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags",
            "description": "vd low_content, no_diacritics, date_unparsed"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail",
            "description": "invalid: errors; failed: error"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CvIngestResult"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "ExplainOut": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "template_version": {
            "type": "string",
            "title": "Template Version"
          },
          "cv_id": {
            "type": "string",
            "title": "Cv Id"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "band": {
            "type": "string",
            "title": "Band"
          },
          "band_label": {
            "type": "string",
            "title": "Band Label"
          },
          "cap_applied": {
            "type": "boolean",
            "title": "Cap Applied"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "sections": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sections"
          },
          "cache_key": {
            "type": "string",
            "title": "Cache Key"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "mode",
          "template_version",
          "cv_id",
          "score",
          "band",
          "band_label",
          "cap_applied",
          "text",
          "sections",
          "cache_key"
        ],
        "title": "ExplainOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HardFilters": {
        "properties": {
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "vd 'TP.HCM'; CV thieu dia diem duoc cho qua"
          },
          "min_years": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Years"
          },
          "allow_remote": {
            "type": "boolean",
            "title": "Allow Remote",
            "default": true
          }
        },
        "type": "object",
        "title": "HardFilters"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ok | degraded (DB loi -> HTTP 503)"
          },
          "db": {
            "type": "string",
            "title": "Db",
            "default": "ok"
          },
          "versions": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Versions"
          },
          "config_files": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Config Files"
