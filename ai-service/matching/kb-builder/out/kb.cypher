// KB kỹ năng IT, phiên bản kb-2026-11-24, sinh bởi kb_pipeline. Không sửa tay: sửa gói rồi chạy lại.
// {"nodes": {"Skill": 1742, "Category": 331, "JobTitle": 124, "Level": 6, "Major": 60, "Source": 30}, "edges": {"EVIDENCED_BY": 2066, "IN_CATEGORY": 1684, "MAPS_TO": 135, "NEAR": 182, "PARENT_OF": 348, "USED_IN": 2133}}
// Chạy: cypher-shell -u neo4j -p <mật khẩu> -f out/kb.cypher

CREATE CONSTRAINT IF NOT EXISTS FOR (n:Skill) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Category) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:JobTitle) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Level) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Major) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Source) REQUIRE n.source_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:RoleGroup) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:KBVersion) REQUIRE n.id IS UNIQUE;
MATCH (n) WHERE n:Skill OR n:Category OR n:JobTitle OR n:Level OR n:Major OR n:Source DETACH DELETE n;
MATCH (:RoleGroup)-[r:NEAR]->(:RoleGroup) DELETE r;
UNWIND ['Backend', 'Frontend', 'Fullstack', 'Mobile', 'Data', 'AI/ML', 'DevOps', 'QA', 'Security', 'Embedded', 'Game', 'Design', 'Business', 'IT Support'] AS g MERGE (:RoleGroup {name: g});
