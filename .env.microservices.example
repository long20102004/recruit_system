# Copy to .env (gốc repo). Docker Compose đọc file này, và các service Java chạy trên máy (IDE / java -jar)
# cũng đọc nó qua spring.config.import. Viết KEY=value, không đặt giá trị trong dấu ngoặc kép.
# Chỉ đặt biến có giá trị giống nhau khi chạy trong Docker và trên máy; biến bỏ trống thì mỗi bên dùng mặc định riêng.
DB_PASSWORD=hirelens-local
MYSQL_ROOT_PASSWORD=root-local
JWT_SECRET=HireLensDemoJwtSecretKeyMustBeAtLeast256BitsLongForHS256!!
SERVICE_TOKEN=hirelens-local-service-token-change-before-deploy
CORS_ORIGINS=http://localhost:5173

# Auth (specs/003-auth-flow). Mặc định gửi mail vào Mailpit (xem tại http://localhost:8025):
# để trống MAIL_* thì chạy trên máy dùng localhost:1025, chạy Docker dùng mailpit:1025.
APP_FRONTEND_URL=http://localhost:5173

# Đăng nhập Google (specs/005-google-login). Tạo OAuth Client ID loại "Web application" trên Google Cloud Console,
# thêm http://localhost:5173 vào "Authorized JavaScript origins". Cùng một giá trị cho backend và FE.
# Để trống thì nút Google bị ẩn và /api/auth/google trả 503.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Gửi mail thật qua Gmail: bật xác minh 2 bước, tạo App Password (https://myaccount.google.com/apppasswords), bỏ # các dòng dưới.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.account@gmail.com
# MAIL_PASSWORD=app-password-16-ky-tu
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=HireLens <your.account@gmail.com>

# Optional remote services (for example a Colab extraction URL).
# CV_EXTRACTION_URL=https://your-extraction-tunnel.example
CV_MODEL_VERSION=v4

# Runtime data on the DATA disk; directories are created by setup-storage.sh.
STORAGE_ROOT=/run/media/long/DATA/project/DO_AN/recruit_system/data/runtime

# Both the Interview backend and AI use this mode; no semantic -> lexical fallback.
# Switch to finetune only after python -m src.finetune_bert --scenario self has written the model.
INTERVIEW_SCORING_MODE=bertscore

# ---- Match CV <-> JD (ai-service/matching/service, profile `match`) ----
# Khoa HMAC cho candidate_key: DOI gia tri, khong commit. Doi khoa = moi CV phai nap lai (backfill).
CVMATCH_HMAC_KEY=change-this-hmac-key-before-running
CVMATCH_DB_PASSWORD=cvmatch-local
# cpu | cuda (cuda: dung them -f docker-compose.gpu.yml)
CVMATCH_DEVICE=cpu
# CVMATCH_CPUS=4
# Ban KB (thu muc trong ai-service/matching/kb-builder/out/snapshot); de trong = theo ai-service/matching/service/config/active.yaml
# CVMATCH_ONTOLOGY_VERSION=kb-2026-11-24
# cvmatch chay may khac (GPU / Colab): dat URL va bat token SERVICE_TOKEN o ca hai phia
# CVMATCH_URL=http://cvmatch-ai:8000
# false: tat dong bo CV/JD sang cvmatch (vd chay stack khong bat profile match)
# CVMATCH_SYNC_ENABLED=true

# ---- Cloudflare R2 (specs/008-r2-storage, xem docs/R2_STORAGE.md) — BAT BUOC cho recruitment-service ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket private: CV PDF, giay phep (truy cap qua presigned URL)
R2_PRIVATE_BUCKET=hirelens-private
# Bucket public: logo, anh bia (da bat r2.dev hoac custom domain)
R2_PUBLIC_BUCKET=hirelens
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# R2_PRESIGN_TTL=5m
# Chay 1 lan de chuyen file cu len R2, xong dat lai false
# STORAGE_MIGRATE_LOCAL=false

# ---- RabbitMQ & notification-service (specs/009-notification-service) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
NOTIFICATION_URL=http://localhost:8084
