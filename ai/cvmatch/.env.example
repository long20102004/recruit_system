# Ket noi PostgreSQL (docker-compose.yml map cong 5433)
CVMATCH_DB_URL=postgresql://cvmatch:cvmatch@127.0.0.1:5433/cvmatch
# Khoa bi mat HMAC cho candidate_key (A2). Doi gia tri that, khong commit.
CVMATCH_HMAC_KEY=change-me
# cuda | cpu
CVMATCH_DEVICE=cuda
# 1 = dung FakeEncoder (test khong GPU)
CVMATCH_FAKE_ENCODER=0
# Thu muc config (mac dinh: ai/cvmatch/config)
# CVMATCH_CONFIG_DIR=
